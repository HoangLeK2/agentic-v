# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-***

# Knowledge retrieval defaults to PostgreSQL keyword search. Configure a dedicated,
# verified embedding endpoint to enable hybrid vector + keyword retrieval.
# OPENAI_EMBEDDING_MODEL_ID=text-embedding-3-small
# OPENAI_EMBEDDING_API_KEY=sk-***
# OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# JWT verification for AgentOS. Generate your JWT_VERIFICATION_KEY at os.agno.com.
# In production (RUNTIME_ENV != dev), the app refuses to serve traffic without
# JWT_VERIFICATION_KEY or JWT_JWKS_FILE. Local dev (RUNTIME_ENV=dev) is ok without it.
# Set `authorization=False` in app/main.py to opt out (not recommended).
# ---------------------------------------------------------------------------
# Quote the value so parsers read the multi-line PEM as one variable:
# JWT_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----
# MIIBIjANBgkq...
# -----END PUBLIC KEY-----"
# JWT_JWKS_FILE=/app/jwks.json

# ---------------------------------------------------------------------------
# AgentOS URL used by the scheduler and MCP server.
# Set this to the public URL of your AgentOS instance.
# ---------------------------------------------------------------------------
# AGENTOS_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# MCP OAuth — set MCP_CONNECT_SECRET to turn the /mcp endpoint into its own
# OAuth 2.1 authorization server, which is how claude.ai and ChatGPT (web) connect.
# Connecting to the MCP server asks for this secret on a consent page.
# Generate a strong one (≥16 chars):
#   openssl rand -base64 32
# ---------------------------------------------------------------------------
# MCP_CONNECT_SECRET=

# Optional: pin the OAuth token signing key (≥32 chars). Unset, a strong key is
# generated and persisted in the database. Rotating it invalidates outstanding tokens.
# AGENTOS_MCP_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Workforce v1
# ---------------------------------------------------------------------------
# Role-specific model IDs are strict: the runtime does not silently fall back.
# WORKFORCE_MODEL_ROUTER_ID=cx/gpt-5.6-luna
# WORKFORCE_MODEL_ENGINEERING_ID=cx/gpt-5.6-sol
# WORKFORCE_MODEL_GROWTH_ID=cx/gpt-5.6-terra
# WORKFORCE_MODEL_RESEARCH_ID=cx/gpt-5.6-terra
# WORKFORCE_MODEL_REVIEW_ID=cx/gpt-5.6-sol-review
# WORKFORCE_MODEL_PROBE_REPORT=/run/config/workforce-model-probe.json
# WORKFORCE_MODEL_PROBE_MAX_AGE_HOURS=24

# The workspace executor is a separate trust boundary. AgentOS never receives
# the Docker socket. Run the local profile only after setting both values:
#   docker compose --profile workforce-executor up -d --build workspace-executor
# WORKSPACE_EXECUTOR_MCP_URL=http://workspace-executor:8100/mcp
# WORKSPACE_EXECUTOR_TOKEN=
# WORKSPACE_EXECUTOR_ALLOWED_HOSTS=workspace-executor:8100
# WORKFORCE_REPOS_FILE=./config/workforce-repos.example.json
# WORKFORCE_SOURCE_ROOT=.
# WORKFORCE_WORKSPACE_ROOT=/absolute/host/path/to/disposable-workspaces
# Keep executor checks self-contained: task containers run with no network and
# therefore cannot depend on Postgres, cloud APIs, or package downloads.

# Buzz uses one bearer token per user. Only token hashes live in the identity file.
# The adapter signs a short-lived JWT; AgentOS verifies the matching public key.
# Store adapter secrets outside this repository and Docker build context.
# BUZZ_IDENTITIES_FILE=../agno/secrets/buzz-identities.json
# BUZZ_TOKEN_PEPPER=
# BUZZ_JWT_PRIVATE_KEY_FILE=../agno/secrets/buzz-jwt-private.pem
# The executor mounts the matching public key and verifies one-time Buzz approval
# tokens bound to the exact workspace id and patch digest.
# BUZZ_JWT_PUBLIC_KEY_FILE=../agno/secrets/buzz-jwt-public.pem
# BUZZ_WORKSPACE_APPROVAL_AUDIENCE=workspace-executor
# Railway: set the PEM contents directly as BUZZ_JWT_VERIFICATION_KEY on AgentOS.
# BUZZ_JWT_VERIFICATION_KEY=
# File-based alternative: BUZZ_JWT_VERIFICATION_KEY_FILE=/run/secrets/buzz-jwt-public.pem
# BUZZ_JWT_AUDIENCE=agentos
# Required on AgentOS when either Buzz verification-key setting is configured.
# Every accepted JWT issuer on this AgentOS must carry this same audience.
# JWT_AUDIENCE=agentos

# ---------------------------------------------------------------------------
# Chief's and the Studio registry's web search tools use the Parallel SDK
# when authenticated, and fall back to Parallel's keyless MCP server otherwise.
# ---------------------------------------------------------------------------
# PARALLEL_API_KEY=

# ---------------------------------------------------------------------------
# Schedules
# ---------------------------------------------------------------------------
# ENABLE_DEPLOY_CHECK=True
# EVALS_TAG=smoke
# EVALS_CASE_TIMEOUT_SECONDS=90
# EVALS_SUITE_TIMEOUT_SECONDS=900
# Maximum recent domain-team runs inspected by each continuous-learning cycle.
# The schedule is registered disabled because extraction and review use model calls.
# CONTINUOUS_LEARNING_MAX_RUNS=12

# ---------------------------------------------------------------------------
# Slack — set both to enable the Slack interface.
#   SLACK_BOT_TOKEN       Bot User OAuth Token (xoxb-***)
#   SLACK_SIGNING_SECRET  Signing Secret (Basic Information → App Credentials)
# ---------------------------------------------------------------------------
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=ai
# DB_PASS=ai
# DB_DATABASE=ai
# DB_DRIVER=postgresql+psycopg
